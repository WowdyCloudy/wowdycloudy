{
  "datasets": [
    {
      "name": "5603f28c",
      "displayName": "Workspaces",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  workspace_id AS workspace_filter\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= '2026-07-06' -- pricing model change\n",
        "  AND workspace_id IS NOT NULL"
      ]
    },
    {
      "name": "8ce8abd2",
      "displayName": "GenieCodeDailyEvents",
      "queryLines": [
        "SELECT\n",
        "  workspace_id,\n",
        "  event_date,\n",
        "  initiated_by,\n",
        "  COUNT(*) AS interact_count\n",
        "FROM\n",
        "  system.access.assistant_events\n",
        "WHERE\n",
        "  event_date >= '2026-07-06' -- pricing model change\n",
        "  AND (\n",
        "    array_contains(:workspace_filter, workspace_id)\n",
        "    OR :workspace_filter IS NULL\n",
        "  )\n",
        "GROUP BY\n",
        "  ALL"
      ],
      "parameters": [
        {
          "displayName": "workspace_filter",
          "keyword": "workspace_filter",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    },
    {
      "name": "cb77fad0",
      "displayName": "GenieDailyCharges",
      "queryLines": [
        "-- ToDo: Add filters below\n",
        "SELECT\n",
        "  workspace_id,\n",
        "  usage_date,\n",
        "  identity_metadata.run_as User,\n",
        "  SUM(usage_quantity * lp.pricing.effective_list.default) Genie_Cost,\n",
        "  currency_code Currency,\n",
        "  SUM(usage_quantity) LLM_DBUs\n",
        "FROM\n",
        "  system.billing.usage usage\n",
        "    JOIN system.billing.list_prices lp\n",
        "      ON usage.sku_name = lp.sku_name\n",
        "      AND usage.cloud = lp.cloud\n",
        "      AND price_start_time <= usage_start_time\n",
        "      AND (\n",
        "        price_end_time IS NULL\n",
        "        or price_end_time >= usage_start_time\n",
        "      )\n",
        "WHERE\n",
        "  usage_date >= '2026-07-06' -- pricing model change\n",
        "  AND billing_origin_product = 'GENIE'\n",
        "  AND usage.sku_name != 'GENIE_FREE_USAGE'\n",
        "  AND (\n",
        "    array_contains(:workspace_filter, workspace_id)\n",
        "    OR :workspace_filter IS NULL\n",
        "  )\n",
        "GROUP BY\n",
        "  ALL"
      ],
      "parameters": [
        {
          "displayName": "workspace_filter",
          "keyword": "workspace_filter",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    },
    {
      "name": "1e162901",
      "displayName": "GenieDailyAllowance",
      "queryLines": [
        "SELECT\n",
        "  workspace_id,\n",
        "  sku_name,\n",
        "  usage_date,\n",
        "  identity_metadata.run_as User,\n",
        "  SUM(usage_quantity) LLM_DBUs\n",
        "FROM\n",
        "  system.billing.usage usage\n",
        "WHERE\n",
        "  usage_date >= '2026-07-20' -- system table SKU change\n",
        "  AND billing_origin_product = 'GENIE'\n",
        "  AND usage.sku_name = 'GENIE_FREE_USAGE'\n",
        "  AND (\n",
        "    array_contains(:workspace_filter, workspace_id)\n",
        "    OR :workspace_filter IS NULL\n",
        "  )\n",
        "GROUP BY\n",
        "  ALL"
      ],
      "parameters": [
        {
          "displayName": "workspace_filter",
          "keyword": "workspace_filter",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    },
    {
      "name": "c1f49f8c",
      "displayName": "GenieCurrentAllowance",
      "queryLines": [
        "SELECT\n",
        "  identity_metadata.run_as User,\n",
        "  SUM(usage_quantity)\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('month', current_date())\n",
        "  AND UPPER(billing_origin_product) = 'GENIE'\n",
        "  AND UPPER(sku_name) = 'GENIE_FREE_USAGE'\n",
        "GROUP BY\n",
        "  ALL"
      ]
    }
  ],
